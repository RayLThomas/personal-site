<footer>
  <div class="fullWidth container py-4">
    <div class="footerInner d-flex flex-wrap justify-content-start align-items-center">
      <p class="footerlinks">
        <strong><span>&#169;</span> {{ "now" | year }}</strong><br />
        <a href="/">{{ site.name }}</a>
      </p>
      <p class="footerlinks ps-5">
        <strong>Follow</strong><br />
        {%- if site.linkedin %}
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener">{% icon "linkedin" %} LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a><br />
        {%- endif %}
        {%- if site.github %}
        <a href="{{ site.github }}" target="_blank" rel="noopener">{% icon "github" %} GitHub<span class="visually-hidden"> (opens in a new tab)</span></a><br />
        {%- endif %}
        <a href="/feed.xml">{% icon "rss" %} Articles RSS</a>
      </p>
    </div>
  </div>
</footer>
