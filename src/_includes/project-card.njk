<div class="col">
  <a href="{{ project.url }}" class="cardLink d-block h-100">
    <div class="card h-100">
      {% if project.data.image %}<img src="{{ project.data.image }}" class="card-img-top" alt="{{ project.data.imageAlt }}" loading="lazy" decoding="async" />{% endif %}
      <div class="card-body">
        <div class="cardTop">
          <span class="cardIcon">{% icon "project" %}</span>
          {% if project.data.status %}<span class="statusBadge">{{ project.data.status }}</span>{% endif %}
        </div>
        <h3 class="card-title">{{ project.data.title }}</h3>
        {% if project.data.description %}<p class="card-text">{{ project.data.description }}</p>{% endif %}
        <div class="cardFoot">
          {% if project.data.technologies %}
          <ul class="techTags list-unstyled">
            {%- for t in project.data.technologies %}
            <li class="techTag">{% set ic = t | techIcon %}{% if ic %}{% icon ic %} {% endif %}{{ t }}</li>
            {%- endfor %}
          </ul>
          {% endif %}
          <span class="cardArrow" aria-hidden="true">&rarr;</span>
        </div>
      </div>
    </div>
  </a>
</div>
